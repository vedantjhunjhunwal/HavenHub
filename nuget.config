<?xml version="1.0" encoding="utf-8"?>
<!-- HavenHub has zero third-party NuGet dependencies (ADR-0001): only the .NET SDK, the ASP.NET Core
     shared framework and the operating system's SQLite library. Clearing sources keeps it that way. -->
<configuration>
  <packageSources>
    <clear />
  </packageSources>
</configuration>
